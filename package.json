{
  "name": "termai",
  "version": "1.0.0",
  "description": "AI-powered shell wrapper with Claude Code and OpenCode support",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "termai": "./dist/bin/termai.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/termai.ts",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:debug": "DEBUG_TESTS=true npm run test",
    "test:gemini": "TEST_CLI=gemini npm run build && TEST_CLI=gemini vitest run",
    "test:cli": "npm run build && node dist/src/test/cli-test.js"
  },
  "keywords": [
    "ai",
    "shell",
    "terminal",
    "claude",
    "claude-code",
    "opencode",
    "cli",
    "pty",
    "ai-assistant"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "strip-ansi": "^7.1.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
